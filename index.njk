---
layout: layout.njk
title: Home
permalink: /
---

<!-- Hero slider -->
<section class="hero">
  <div class="hero__slides">
    {% for slide in home.hero_slides %}
    <div class="hero__slide {{ 'is-active' if loop.first }}">
      <div class="wrap">
        <div class="hero__inner">
          <span class="eyebrow">{{ slide.eyebrow }}</span>
          <h1>{{ slide.heading }}</h1>
          <p>{{ slide.text }}</p>
          <a href="{{ slide.button_link }}" class="btn btn--lg">{{ slide.button_label }}</a>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
  <div class="hero__dots">
    {% for slide in home.hero_slides %}
    <button class="{{ 'is-active' if loop.first }}" aria-label="Slide {{ loop.index }}"></button>
    {% endfor %}
  </div>
</section>

<!-- Consultation banner -->
<section class="banner">
  <div class="wrap">
    <h3>{{ home.consultation_banner.text }}</h3>
    <a href="{{ home.consultation_banner.button_link }}" class="btn">{{ home.consultation_banner.button_label }}</a>
  </div>
</section>

<!-- Feature cards -->
<section class="features section">
  <div class="wrap">
    <div class="grid">
      {% set icons = [
        '<svg viewBox="0 0 24 24"><path d="M12 1 3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5l-9-4zm-1 15-4-4 1.4-1.4L11 13.2l5.6-5.6L18 9l-7 7z"/></svg>',
        '<svg viewBox="0 0 24 24"><path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10zm0 2c-3.3 0-10 1.7-10 5v3h20v-3c0-3.3-6.7-5-10-5z"/></svg>',
        '<svg viewBox="0 0 24 24"><path d="M12 21s-7.5-4.7-9.7-9.2C.7 8.4 2.5 5 6 5c2 0 3.3 1.1 4 2.1C10.7 6.1 12 5 14 5c3.5 0 5.3 3.4 3.7 6.8C19.5 16.3 12 21 12 21z"/></svg>'
      ] %}
      {% for f in home.features %}
      <div class="feature">
        <div class="feature__icon">{{ icons[loop.index0] | safe }}</div>
        <h3>{{ f.title }}</h3>
        <h4>{{ f.subtitle }}</h4>
        <p>{{ f.text }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Services -->
<section class="services section section--soft">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Our Services</span>
      <h2>{{ home.services_intro.heading }}</h2>
      <p>{{ home.services_intro.text }}</p>
    </div>
    <div class="grid">
      {% set sicons = [
        '<svg viewBox="0 0 24 24"><path d="M12 1 3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5l-9-4z"/></svg>',
        '<svg viewBox="0 0 24 24"><path d="M3 13h4v8H3v-8zm7-6h4v14h-4V7zm7-4h4v18h-4V3z"/></svg>',
        '<svg viewBox="0 0 24 24"><path d="M12 3 2 8l10 5 8-4v6h2V8L12 3zM6 12.2V16c0 1.7 3.1 3 6 3s6-1.3 6-3v-3.8l-6 3-6-3z"/></svg>'
      ] %}
      {% for s in home.services %}
      <div class="service">
        <div class="service__icon">{{ sicons[loop.index0] | safe }}</div>
        <h3>{{ s.title }}</h3>
        <p>{{ s.text }}</p>
        <a href="{{ s.button_link }}" class="btn btn--outline">{{ s.button_label }}</a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- About / why choose us -->
<section class="about section">
  <div class="wrap">
    <div class="about__media">
      <div class="stat">
        <b>3</b>
        <span>Pillars: Protect &middot; Grow &middot; Secure</span>
      </div>
    </div>
    <div>
      <span class="eyebrow">Why Choose Us</span>
      <h2>{{ home.about.heading }}</h2>
      <p>{{ home.about.text }}</p>
      <a href="/contact/" class="btn">Book a Consultation</a>
    </div>
  </div>
</section>

<!-- Team -->
<section class="team section section--soft">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Our Team</span>
      <h2>{{ home.team_intro.heading }}</h2>
      <p>{{ home.team_intro.text }}</p>
    </div>
    <div class="grid">
      {% for m in home.team %}
      <div class="member">
        <div class="member__photo">
          {% if m.photo %}<img src="{{ m.photo }}" alt="{{ m.name }}" />{% endif %}
        </div>
        <div class="member__body">
          <h3>{{ m.name }}</h3>
          <div class="member__role">{{ m.role }}</div>
          <p>{{ m.bio }}</p>
          <a href="/contact/" class="btn btn--outline">Contact</a>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta section section--navy">
  <div class="wrap">
    <span class="eyebrow">{{ home.cta.eyebrow }}</span>
    <h2>{{ home.cta.heading }}</h2>
    <p>{{ home.cta.text }}</p>
    <a href="{{ home.cta.button_link }}" class="btn btn--lg">{{ home.cta.button_label }}</a>
  </div>
</section>

<!-- Latest posts -->
<section class="blog section">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{{ home.blog_intro.eyebrow }}</span>
      <h2>{{ home.blog_intro.heading }}</h2>
      <p>{{ home.blog_intro.text }}</p>
    </div>
    <div class="posts">
      {% for post in collections.posts | reverse %}
      {% if loop.index <= 3 %}
      <article class="post-card">
        <a class="post-card__img" href="{{ post.url }}">
          {% if post.data.image %}<img src="{{ post.data.image }}" alt="{{ post.data.title }}" />{% endif %}
        </a>
        <div class="post-card__body">
          <span class="post-card__cat">{{ post.data.category }}</span>
          <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
          <div class="post-card__meta">{{ post.date | readableDate }}</div>
        </div>
      </article>
      {% endif %}
      {% endfor %}
    </div>
    <div style="text-align:center; margin-top:44px;">
      <a href="/blog/" class="btn">View All Articles</a>
    </div>
  </div>
</section>
