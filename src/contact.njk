---
layout: layout.njk
title: Contact Us
permalink: /contact/
description: Get in touch with Legacy Financial Planning. Call, email, or send us a message and we'll respond within two business days.
---

<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">Contact Us</span>
    <h1>Get in Touch &amp; Reach Us</h1>
    <p class="crumb">We respond within 48 hours — we look forward to hearing from you.</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="contact-grid">

      <!-- Details -->
      <div>
        <span class="eyebrow">Our Details</span>
        <h2 style="font-size:28px; margin-bottom:24px;">Let's start a conversation</h2>
        <div class="contact-info">
          <div class="item">
            <svg viewBox="0 0 24 24"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.3 1l-2.2 2.2z"/></svg>
            <div>
              <h4>Phone Number</h4>
              <p><a href="tel:{{ site.phone | replace(' ', '') | replace('(', '') | replace(')', '') | replace('-', '') }}">{{ site.phone }}</a></p>
            </div>
          </div>
          <div class="item">
            <svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg>
            <div>
              <h4>Email Address</h4>
              <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
              {% if site.email_secondary %}<p><a href="mailto:{{ site.email_secondary }}">{{ site.email_secondary }}</a></p>{% endif %}
            </div>
          </div>
          <div class="item">
            <svg viewBox="0 0 24 24"><path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
            <div>
              <h4>Our Address</h4>
              <p>{{ site.address }}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Form (Formspree) -->
      <div class="form-card">
        <h2 style="font-size:24px; margin-bottom:20px;">Send us a message</h2>
        <form method="POST" action="https://formspree.io/f/mzdnkaay">
          <input type="hidden" name="_next" value="https://legacyfinancialplanning.ca/contact/thanks/" />
          <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
          <div class="form-row">
            <div class="field">
              <label for="name">Full Name</label>
              <input id="name" type="text" name="name" required />
            </div>
            <div class="field">
              <label for="phone">Phone</label>
              <input id="phone" type="tel" name="phone" />
            </div>
          </div>
          <div class="field">
            <label for="email">Email Address</label>
            <input id="email" type="email" name="email" required />
          </div>
          <div class="field">
            <label for="subject">Subject</label>
            <input id="subject" type="text" name="subject" />
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" required></textarea>
          </div>
          <button type="submit" class="btn btn--lg">Send Message</button>
        </form>
      </div>

    </div>

    <!-- Map -->
    <div class="map-embed">
      <iframe
        title="Legacy Financial Planning location"
        src="https://www.google.com/maps?q=3999+Henning+Dr+%23402,+Burnaby,+BC+V5C+6P7&output=embed"
        loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>
</section>
