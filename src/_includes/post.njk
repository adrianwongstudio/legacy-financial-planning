---
layout: layout.njk
---

<section class="page-hero">
  <div class="wrap">
    {% if category %}<a class="eyebrow eyebrow--link" href="{{ ('/blog/category/' + (category | slugify) + '/') | url }}">{{ category }}</a>{% endif %}
    <h1>{{ title }}</h1>
    <p class="crumb">{{ date | readableDate }}{% if author %} &middot; by {{ author }}{% endif %}</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <article class="article">
      {% if image %}<img src="{{ image | url }}" alt="{{ title }}" style="object-position: {{ image_position or 'center' }};" />{% endif %}
      {{ content | safe }}
      {% if tags %}
      <div class="article__tags">
        {% for tag in tags %}<a class="chip" href="{{ ('/blog/tag/' + (tag | slugify) + '/') | url }}">{{ tag }}</a>{% endfor %}
      </div>
      {% endif %}
      <a class="back-link" href="{{ '/blog/' | url }}">&larr; Back to all articles</a>
    </article>
  </div>
</section>
